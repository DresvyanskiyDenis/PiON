#!/usr/bin/env bash
# pi-tier — resolve a semantic tier name to a provider-qualified model id.
#
# WHY (REQ-PRV-07, REQ-CTX-81): nothing outside config/routing.json may hard-code a
# model id. Extensions read routing.json directly; shell scripts, cron jobs and
# `pi -p` one-liners use this. Repointing a tier is then a one-line edit in one file.
#
#   pi -p "summarise" --model "$(pi-tier light)"
#   pi-tier --list
#   pi-tier --thinking strong        # prints the tier's thinking level
#   pi-tier --egress databricks      # prints a provider's declared egress class
#
# Exit 2 on an unknown tier — a typo must fail loudly, never silently fall back.
# There is no --fallback: this harness has no provider failover, and routing.json is
# forbidden from carrying a "fallback" key at all (bin/pi-check rule PC-03).
set -uo pipefail

# routing.json is GENERATED by scripts/install.sh from config/routing.default.json plus
# config/providers/*.json; it is git-ignored so a fork can never publish someone's endpoints.
# On a fresh clone it is simply absent, so say which command creates it. Never fall back to
# the shipped default: running on a routing table nobody chose is the failure this avoids.
ROUTING="${PI_ROUTING_JSON:-$HOME/.pi/agent/routing.json}"
[ -f "$ROUTING" ] || {
  echo "pi-tier: no routing.json at $ROUTING" >&2
  echo "pi-tier: routing.json is generated from config/routing.default.json — run scripts/install.sh" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || { echo "pi-tier: jq is required" >&2; exit 1; }

case "${1:-}" in
  --list|-l)
    jq -r '.tiers | to_entries[] | "\(.key)\t\(.value.model)\t\(.value.purpose)"' "$ROUTING"
    # Tiers in the vocabulary that this install deliberately left unbound (no provider of the
    # right kind was configured). Listed so a caller can see WHY the name it wanted is missing.
    jq -r '(.tiersUnbound // {}) | to_entries[] | "\(.key)\tUNBOUND\t\(.value)"' "$ROUTING"
    exit 0 ;;
  --thinking)
    v="$(jq -r --arg t "${2:-}" '.tiers[$t].thinkingLevel // empty' "$ROUTING")"
    [ -n "$v" ] || { echo "pi-tier: unknown tier '${2:-}'" >&2; exit 2; }
    printf '%s\n' "$v"; exit 0 ;;
  --egress)
    v="$(jq -r --arg p "${2:-}" '.egress[$p] // empty' "$ROUTING")"
    [ -n "$v" ] || { echo "pi-tier: no egress class for provider '${2:-}'" >&2; exit 2; }
    printf '%s\n' "$v"; exit 0 ;;
  ""|-h|--help)
    echo "usage: pi-tier <tier> | --list | --thinking <tier> | --egress <provider>" >&2
    exit 1 ;;
esac

MODEL="$(jq -r --arg t "$1" '.tiers[$t].model // empty' "$ROUTING")"
if [ -z "$MODEL" ]; then
  # A tier named in tiersUnbound is not a typo — it is a real tier this install cannot honour.
  # Say which, and why, instead of "unknown".
  REASON="$(jq -r --arg t "$1" '(.tiersUnbound // {})[$t] // empty' "$ROUTING")"
  if [ -n "$REASON" ]; then
    echo "pi-tier: tier '$1' is NOT BOUND on this install. $REASON" >&2
    echo "pi-tier: nothing is substituted for it — bind it in routing.json or re-run scripts/install.sh" >&2
  else
    echo "pi-tier: unknown tier '$1' (try --list)" >&2
  fi
  exit 2
fi

# The tier's `thinkingLevel` is appended as a `:level` suffix, because the model string is the only
# place PI reads reasoning effort from, and `pi --model` parses that suffix. Printing the bare id
# ran every `pi-tier`-driven call at the provider's default effort while routing.json declared
# otherwise — a silent downgrade, and this harness does not do silent substitution.
#
# `.tiers[t].model` is contractually a BARE `provider/id`; the level lives in its own field. Writing
# `provider/id:high` into `model` instead looks equivalent and is not: PI keys its model registry on
# bare ids, so every consumer that does not strip the suffix reads it as part of the id.
#
# A level already pinned in the model string is the more specific statement and wins. An unknown one
# is refused here rather than sent to a provider that has never heard of it.
LEVEL="$(jq -r --arg t "$1" '.tiers[$t].thinkingLevel // empty' "$ROUTING")"
if [ -n "$LEVEL" ]; then
  case "$LEVEL" in
    off|minimal|low|medium|high|xhigh|max) ;;
    *) echo "pi-tier: tier '$1' declares thinkingLevel '$LEVEL', which is not off|minimal|low|medium|high|xhigh|max — fix routing.json" >&2; exit 2 ;;
  esac
  case "$MODEL" in
    *:off|*:minimal|*:low|*:medium|*:high|*:xhigh|*:max) ;;
    *) MODEL="$MODEL:$LEVEL" ;;
  esac
fi

printf '%s\n' "$MODEL"
