{
  "compaction": {
    "loopGuard": {
      "maxNonReducingPasses": 3,
      "minReductionRatio": 0.15,
      "minEntriesBetweenPasses": 2,
      "headlessExitCode": 91
    },
    "instructions": {
      "enabled": true
    },
    "pinned": {
      "enabled": true,
      "sources": ["AGENTS.md", "CLAUDE.md"],
      "maxBytesPerSource": 4096,
      "maxTotalBytes": 16384,
      "facts": {
        "enabled": true,
        "maxEntries": 40,
        "maxBytes": 8000
      }
    },
    "threshold": {
      "absoluteTokens": 200000,
      "toleranceRatio": 0.2
    }
  }
}
