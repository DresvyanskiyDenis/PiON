#!/usr/bin/env bash
# pi-log sessions | pi-log events | pi-log cost | pi-log cache
#
# EXT-26's greppable face — usable with PI not running, since it only reads index.db
# (extensions/session-index/*.ts is the writer; this script never opens it for write).
set -euo pipefail

db="${PI_INDEX_DB:-$HOME/.pi/agent/index.db}"

if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "pi-log: sqlite3 CLI not found on PATH" >&2
  exit 2
fi

if [ ! -f "$db" ]; then
  echo "pi-log: no index at $db yet — run '/index' inside pi first" >&2
  exit 1
fi

case "${1:-sessions}" in
  sessions)
    sqlite3 -header -column "$db" "
      SELECT substr(id,1,8) id, title, model, turns,
             tokens_input+tokens_output tok,
             CASE cost_known WHEN 1 THEN printf('\$%.3f',cost_usd) ELSE 'n/a' END cost,
             datetime(ended_at/1000,'unixepoch','localtime') ended
      FROM sessions ORDER BY ended_at DESC LIMIT 50;"
    ;;
  events)
    sqlite3 -header -column "$db" "
      SELECT datetime(ts/1000,'unixepoch','localtime') t, kind, name, ok, ms, payload
      FROM events ORDER BY ts DESC LIMIT 200;"
    ;;
  cost)
    sqlite3 -header -column "$db" "
      SELECT model, count(*) sessions,
             CASE WHEN sum(cost_known)=count(*) THEN printf('\$%.2f',sum(cost_usd)) ELSE 'partial' END total
      FROM sessions GROUP BY model ORDER BY 3 DESC;"
    ;;
  cache)
    # Prefix stability, per session. `reuse` is cacheRead / cacheWrite: how many tokens the
    # provider served out of its cache for every token it had to write into it.
    #
    # Reading it: a session whose cached prefix keeps GROWING re-reads the whole conversation each
    # turn and writes only the new tail, so `reuse` climbs with turn count and is well above 1 by
    # the tenth turn. A `reuse` at or below ~0.5 over a long session means the prefix is being
    # REBUILT rather than extended — something ahead of the conversation (system prompt, tool
    # roster) is changing between turns. docs/limitations.md has the method, including why this is
    # a smell test and not a proof: it aggregates a whole session and cannot say which turn diverged.
    #
    # `w/turn` is the same defect in absolute terms: cacheWrite per turn stays near the size of one
    # turn's new text while the prefix is stable, and approaches whole-context size when it is not.
    sqlite3 -header -column "$db" "
      SELECT substr(id,1,8) id, model, turns,
             tokens_cache_write cw, tokens_cache_read cr,
             CASE WHEN tokens_cache_write>0
                  THEN printf('%.2f', 1.0*tokens_cache_read/tokens_cache_write) ELSE 'n/a' END reuse,
             CASE WHEN turns>0 THEN tokens_cache_write/turns ELSE 0 END 'w/turn',
             datetime(ended_at/1000,'unixepoch','localtime') ended
      FROM sessions WHERE turns > 0 ORDER BY ended_at DESC LIMIT 50;"
    ;;
  *)
    echo "usage: pi-log [sessions|events|cost|cache]" >&2
    exit 2
    ;;
esac
